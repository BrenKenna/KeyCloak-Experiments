{
    "realm": "machine-roles",
    "enabled": true,
    "displayName": "Machine Roles",
    "sslRequired": "none",
    "clients": [
        {
            "clientId": "server-a",
            "name": "Server-A API",
            "enabled": true,
            "protocol": "openid-connect",
            "publicClient": false,
            "clientAuthenticatorType": "client-secret",
            "secret": "super-secret-server-a-key",
            "serviceAccountsEnabled": true,
            "standardFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "implicitFlowEnabled": false,
            "authorizationServicesEnabled": false,
            "redirectUris": [],
            "webOrigins": [],
            "protocolMappers": [{
                "name": "server-b-audience",
                "protocol": "openid-connect",
                "protocolMapper": "oidc-audience-mapper",
                "consentRequired": false,
                "config": {
                    "included.client.audience": "server-b",
                    "id.token.claim": "false",
                    "access.token.claim": "true"
                }
            }],
            "attributes": {
                "standard.token.exchange.enabled": "true"
            }
        },
        {
            "clientId": "server-b",
            "name": "Server-B API",
            "enabled": true,
            "protocol": "openid-connect",
            "publicClient": false,
            "clientAuthenticatorType": "client-secret",
            "serviceAccountsEnabled": true,
            "secret": "super-secret-server-b-key",
            "standardFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "implicitFlowEnabled": false,
            "authorizationServicesEnabled": false,
            "redirectUris": [],
            "webOrigins": [],
            "attributes": {
                "standard.token.exchange.enabled": "true"
            }
        }
    ],
    "roles": {
        "client": {
            "server-a": [
                {
                    "name": "hash",
                    "description": "Allow calling the serverA hashing endpoint"
                }
            ],
            "server-b": [
                {
                    "name": "encrypt",
                    "description": "Allows calling the serverB encryption endpoints"
                }
            ]
        }
    },
    "users": [
        {
            "username": "service-account-server-a",
            "enabled": true,
            "serviceAccountClientId": "server-a",
            "clientRoles": {
                "server-a": [
                    "hash"
                ]
            }
        },
        {
            "username": "service-account-server-b",
            "enabled": true,
            "serviceAccountClientId": "server-b",
            "clientRoles": {
                "server-b": [
                    "encrypt"
                ]
            }
        }
    ]
}